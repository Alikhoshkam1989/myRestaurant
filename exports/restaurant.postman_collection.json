{
  "info": {
    "name": "Restaurant API - Ali Khoshkam",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Lokale demonstratie. Start met een tokenverzoek. Gebruik voor normaal inloggen Authorization Code + PKCE; password grant is uitsluitend ingeschakeld voor de lokale testcollectie."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "authUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "categoriesId",
      "value": "1"
    },
    {
      "key": "productsId",
      "value": "1"
    },
    {
      "key": "tablesId",
      "value": "1"
    },
    {
      "key": "reservationsId",
      "value": "1"
    },
    {
      "key": "ordersId",
      "value": "1"
    },
    {
      "key": "invoicesId",
      "value": "1"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Authenticatie (lokale demo)",
      "item": [
        {
          "name": "Token klant",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "url": "{{authUrl}}/realms/restaurant/protocol/openid-connect/token",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password",
                  "type": "text"
                },
                {
                  "key": "client_id",
                  "value": "restaurant-postman",
                  "type": "text"
                },
                {
                  "key": "username",
                  "value": "klant",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "Klant-Demo-2026!",
                  "type": "text"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Token ontvangen\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) pm.collectionVariables.set(\"token\", pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Token personeel",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "url": "{{authUrl}}/realms/restaurant/protocol/openid-connect/token",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password",
                  "type": "text"
                },
                {
                  "key": "client_id",
                  "value": "restaurant-postman",
                  "type": "text"
                },
                {
                  "key": "username",
                  "value": "personeel",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "Personeel-Demo-2026!",
                  "type": "text"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Token ontvangen\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) pm.collectionVariables.set(\"token\", pm.response.json().access_token);"
                ]
              }
            }
          ]
        }
